{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plant.schema.json",
  "title": "LeafGuru Plant",
  "type": "object",
  "required": [
    "id",
    "name",
    "stage",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "growId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "optional grow this record belongs to"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "strainTemplateId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "customStrain": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "sex": {
      "enum": [
        "unknown",
        "regular",
        "female",
        "male"
      ],
      "default": "unknown"
    },
    "germinationDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "stage": {
      "enum": [
        "planned",
        "germinating",
        "seedling",
        "vegetative",
        "flowering",
        "harvest",
        "drying",
        "fermented",
        "cured"
      ]
    },
    "locationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "status": {
      "enum": [
        "growing",
        "harvested",
        "dried",
        "fermented",
        "cured",
        "died"
      ]
    },
    "harvestYieldG": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "dried bud yield in grams (recorded at harvest)"
    },
    "budG": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "grams of buds harvested"
    },
    "leafG": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "grams of leaves harvested (trim, fan leaves)"
    },
    "sugarLeafG": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "grams of sugar leaves harvested"
    },
    "stemG": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "grams of stems harvested"
    },
    "smellTerpenes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "description": "smell / terpene profile (e.g. 'citrus, diesel')"
    },
    "harvestedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "day the plant was harvested"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 5000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
