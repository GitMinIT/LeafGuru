{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "equipment.schema.json",
  "title": "LeafGuru Equipment",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "growId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "optional grow this record belongs to"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "category": {
      "enum": [
        "light",
        "pot",
        "soil",
        "fan",
        "filter",
        "nutrient",
        "sensor",
        "other"
      ]
    },
    "specs": {
      "type": "string",
      "maxLength": 2000
    },
    "purchaseDate": {
      "type": "string",
      "format": "date"
    },
    "cost": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "status": {
      "enum": [
        "in-use",
        "stored",
        "broken",
        "sold"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    },
    "locationAssignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "locationId",
          "from"
        ],
        "properties": {
          "locationId": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "createdAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "availableEverywhere": {
      "type": "boolean",
      "default": false,
      "description": "equipment usable at all locations without explicit assignment"
    }
  },
  "additionalProperties": false
}
