{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "location.schema.json",
  "title": "LeafGuru Location",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "active"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "type": {
      "enum": [
        "indoor",
        "outdoor"
      ]
    },
    "size": {
      "type": "object",
      "properties": {
        "widthCm": {
          "type": "number",
          "minimum": 0
        },
        "depthCm": {
          "type": "number",
          "minimum": 0
        },
        "heightCm": {
          "type": "number",
          "minimum": 0
        },
        "areaM2": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
