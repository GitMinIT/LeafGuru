{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stage-log.schema.json",
  "title": "LeafGuru StageLog",
  "type": "object",
  "required": [
    "id",
    "plantId",
    "stage",
    "enteredAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "plantId": {
      "type": "string",
      "format": "uuid"
    },
    "stage": {
      "enum": [
        "planned",
        "germinating",
        "seedling",
        "vegetative",
        "flowering",
        "harvest",
        "drying",
        "cured"
      ]
    },
    "enteredAt": {
      "type": "string",
      "format": "date-time"
    },
    "leftAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "createdAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}