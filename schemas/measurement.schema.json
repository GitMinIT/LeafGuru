{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "measurement.schema.json",
  "title": "LeafGuru Measurement",
  "type": "object",
  "required": [
    "id",
    "plantId",
    "type",
    "value",
    "unit",
    "measuredAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "plantId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10
    },
    "measuredAt": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string",
      "maxLength": 500
    },
    "createdAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}