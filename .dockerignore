# Keep the build context small and the image free of local state.
.git
.gitignore
node_modules
__pycache__
*.pyc
*.pyo
.pytest_cache
.ruff_cache
.mypy_cache

# local runtime state (never part of the image)
db.sqlite3
db.sqlite3-journal
media
staticfiles
secrets
.env
.envrc
*.log

# the browser test suite needs node_modules, so it is not part of the
# runtime image either
tests
