{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "photo.schema.json",
  "title": "LeafGuru Photo",
  "type": "object",
  "required": [
    "id",
    "takenAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "plantId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "plant this photo belongs to (null for grow/log-level shots)"
    },
    "logEntryId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "journal entry this photo was attached to"
    },
    "blob": {
      "description": "IndexedDB: stored as Blob/File object; export/import serializes to base64 data URL string"
    },
    "mimeType": {
      "enum": [
        "image/jpeg",
        "image/png",
        "image/webp"
      ]
    },
    "takenAt": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string",
      "maxLength": 500
    },
    "phaseTag": {
      "enum": [
        null,
        "seedling",
        "vegetative",
        "flowering",
        "harvest",
        "drying",
        "cured"
      ]
    },
    "createdAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}