{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "strain-template.schema.json",
  "title": "LeafGuru StrainTemplate",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "breeder": {
      "type": "string",
      "maxLength": 120
    },
    "genotype": {
      "enum": [
        "indica",
        "sativa",
        "hybrid",
        "unknown"
      ]
    },
    "stageDurations": {
      "type": "object",
      "description": "expected days per stage",
      "properties": {
        "seedling": {
          "type": "integer",
          "minimum": 0
        },
        "vegetative": {
          "type": "integer",
          "minimum": 0
        },
        "flowering": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "expectedHeightCm": {
      "type": "number",
      "minimum": 0
    },
    "characteristics": {
      "type": "string",
      "maxLength": 2000
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    }
  }
}