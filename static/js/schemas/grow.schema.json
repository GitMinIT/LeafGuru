{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "grow.schema.json",
  "title": "LeafGuru Grow",
  "type": "object",
  "required": [
    "id",
    "name",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "harvested",
        "closed"
      ]
    },
    "locationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "locations used by this grow",
      "default": []
    },
    "startDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "endDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
